# Copy to .env.prod and fill in. Used by compose.prod.yaml.
# Public host name; Caddy gets its certificate for it
DOMAIN=anycardz.example.org
POSTGRES_PASSWORD=change-me
# Named in the terms of service and privacy notice: who runs the site, and an
# address players can write to (bugs, data requests)
OPERATOR=
CONTACT=
# Web Push: generate with `docker compose -f compose.prod.yaml run --rm api anycardz-api vapid-keys`
# (or `cargo run -p anycardz-api -- vapid-keys`). Keep the key: changing it drops every subscription.
# The subject defaults to mailto:CONTACT when CONTACT is an email address.
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Checkout of the anycardz-data repository on the server
DATA_DIR=../anycardz-data
RUST_LOG=info
# Prometheus scraping: where /metrics is published on the host, and the bearer
# token it must send. Publishing on all interfaces (0.0.0.0:9100) needs a token.
METRICS_PUBLISH=127.0.0.1:9100
METRICS_TOKEN=
# Logs (deploy/compose.logs.yaml): where Loki listens for Grafana. The host only
# by default; Loki has no login, see docs/deploy.md before publishing it.
LOKI_PUBLISH=127.0.0.1:3100
