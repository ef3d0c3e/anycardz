# Postgres from compose.yaml (host port 5433)
DATABASE_URL=postgres://anycardz:anycardz@127.0.0.1:5433/anycardz
# Card data repository
ANYCARDZ_DATA=../anycardz-data
# Thumbnail cache
ANYCARDZ_CACHE=backend/cache
# Where the API listens
ANYCARDZ_BIND=127.0.0.1:8080
# Set to 1 to load collections tagged "dev"
ANYCARDZ_DEV_COLLECTIONS=0
# Set to 1 when served over HTTPS so the session cookie is Secure
ANYCARDZ_SECURE_COOKIES=0
# Proxies whose X-Forwarded-For gives the client address (comma separated IPs)
ANYCARDZ_TRUSTED_PROXIES=
# Prometheus /metrics listener (unset: none) and its optional bearer token
ANYCARDZ_METRICS_BIND=127.0.0.1:9100
ANYCARDZ_METRICS_TOKEN=
# 1 lifts the login and sign-up rate limits: development and tests only
ANYCARDZ_RELAXED_LIMITS=1
RUST_LOG=info,anycardz_api=debug
# Integration tests (cargo test) use their own database
TEST_DATABASE_URL=postgres://anycardz:anycardz@127.0.0.1:5433/anycardz_test
